    {
      "name": "Client — Optional MFA prompt",
      "kind": "custom",
      "refersTo": "client-security-banner",
      "description": "Dismissible enrollment prompt, shown only from actual second-factor state on eligible client overviews.",
      "html": "<section class=\"ds-client-security\"><div><p>Включите двухфакторную аутентификацию</p><p class=\"ds-client-security-copy\">Дополнительная защита входа</p></div><a class=\"ds-client-button\" href=\"/account-security\">Подключить</a></section>",
      "css": ".ds-client-button{display:inline-flex;justify-content:center;align-items:center;gap:.5rem;min-height:2.25rem;padding:.5rem 1rem;border:1px solid #2b2b2b;border-radius:.5rem;background:#2b2b2b;color:white;font:600 .875rem/1.25rem Garet,sans-serif;cursor:pointer;}.ds-client-button:hover{background:#1a1a1a;color:white;}.ds-client-button:disabled{opacity:.6;cursor:wait;}.ds-client-button:focus-visible{outline:2px solid #2563eb;outline-offset:2px;}@media(max-width:700px){.ds-client-button{min-height:44px;}}.ds-client-security{display:flex;align-items:center;gap:.75rem;padding:1rem;border:1px solid #c7caed;border-radius:1rem;background:#eff0f9;color:#030712;font:400 .875rem/1.5 Garet,sans-serif;}.ds-client-security>div{flex:1;}.ds-client-security p{margin:0;}.ds-client-security-copy{color:#6b7280;}.ds-client-security a{text-decoration:none;}@media(max-width:700px){.ds-client-security{flex-wrap:wrap;}}"
