    {
      "name": "Reference — Main panel",
      "kind": "card",
      "refersTo": "client-panel",
      "description": "White bordered panel with 1rem corners.",
      "html": "<section class=\"ds-client-panel\"><h2 class=\"ds-client-title\">Документы</h2><p class=\"ds-client-copy\">Здесь появятся документы по делу.</p></section>",
      "css": ".ds-client-panel{padding:1.75rem;border:1px solid #e5e7eb;border-radius:1rem;background:white;color:#030712;font-family:Garet,sans-serif;}.ds-client-title{margin:0 0 1.5rem;font-size:1.25rem;font-weight:600;line-height:1.75rem;}.ds-client-copy{margin:0;color:#6b7280;font-size:.875rem;line-height:1.25rem;}@media(max-width:700px){.ds-client-panel{padding:1.25rem;}}"
